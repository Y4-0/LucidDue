# 1. Database Connection URL
# Replace this with your PostgreSQL connection string.
# Example: postgres://postgres:password@localhost:5432/luciddue
DATABASE_URL=""

# 2. Better Auth Secret
# Generate a random string for this (e.g., using `openssl rand -hex 32` in terminal)
BETTER_AUTH_SECRET=""

# 3. Google OAuth Credentials (for Google Login)
# Get these from the Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. Frontend URL (for CORS and Auth redirects)
# The URL where your Next.js app will be running
FRONTEND_URL="http://localhost:3000"
